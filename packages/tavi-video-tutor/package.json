{
  "name": "tavi-video-tutor",
  "version": "0.4.1",
  "description": "Enterprise-grade React video player & automated multilingual subtitle engine powered by real Whisper ASR, NLLB/M2M100 neural translation, and multi-tier source priority.",
  "type": "module",
  "main": "./dist/tavi-video-tutor.umd.cjs",
  "module": "./dist/tavi-video-tutor.js",
  "types": "./src/index.d.ts",
  "bin": {
    "aitutor": "bin/aitutor.js"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/tavi-video-tutor.js",
      "require": "./dist/tavi-video-tutor.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "test:qa": "node scripts/runEdgeCaseAndProductionQA.js"
  },
  "keywords": [
    "aitutor",
    "tavi-video-tutor",
    "subtitles",
    "webvtt",
    "whisper",
    "nllb",
    "multilingual",
    "react-video-player",
    "asr",
    "translation"
  ],
  "license": "MIT",
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
