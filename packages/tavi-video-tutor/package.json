{
  "name": "tavi-video-tutor",
  "version": "2.0.0",
  "description": "Enterprise-grade React video player SDK & automated multilingual subtitle engine powered by Web Worker VTT parsing, modular custom hooks, plugin architecture, offline IndexedDB storage, razor-sharp High-DPI canvas subtitle renderer, automatic video quality ladder, and WAI-ARIA accessibility.",
  "type": "module",
  "main": "./dist/tavi-video-tutor.umd.cjs",
  "module": "./dist/tavi-video-tutor.js",
  "types": "./src/index.d.ts",
  "bin": {
    "aitutor": "bin/aitutor.js"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/tavi-video-tutor.js",
      "require": "./dist/tavi-video-tutor.umd.cjs"
    },
    "./player": {
      "types": "./src/index.d.ts",
      "import": "./src/components/AITutor.jsx",
      "default": "./src/components/AITutor.jsx"
    },
    "./cli": {
      "import": "./src/cli/cli.js",
      "default": "./src/cli/cli.js"
    },
    "./subtitles": {
      "import": "./src/subtitles/resolver/subtitleResolver.js",
      "default": "./src/subtitles/resolver/subtitleResolver.js"
    },
    "./dist/style.css": "./dist/tavi-video-tutor.css",
    "./style.css": "./dist/tavi-video-tutor.css",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "test:qa": "node scripts/runEdgeCaseAndProductionQA.js"
  },
  "keywords": [
    "aitutor",
    "tavi-video-tutor",
    "subtitles",
    "webvtt",
    "whisper",
    "nllb",
    "multilingual",
    "react-video-player",
    "asr",
    "translation",
    "video-quality",
    "h264-transcoding"
  ],
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "devDependencies": {}
}
