{
  "name": "tavi-video-tutor",
  "version": "2.2.1",
  "description": "Enterprise-grade React video player SDK & automated multilingual subtitle & audio dubbing engine powered by Web Worker VTT parsing, TTS speech synthesis, timestamp alignment, automatic video quality ladder, and WAI-ARIA accessibility.",

  "type": "module",
  "main": "./dist/tavi-video-tutor.cjs",
  "module": "./dist/tavi-video-tutor.js",
  "types": "./src/index.d.ts",
  "bin": {
    "aitutor": "bin/aitutor.js"
  },
  "files": [
    "dist",
    "bin/aitutor.js",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/tavi-video-tutor.js",
      "require": "./dist/tavi-video-tutor.cjs"
    },
    "./player": {
      "types": "./src/index.d.ts",
      "import": "./dist/player.js",
      "require": "./dist/player.cjs",
      "default": "./dist/player.js"
    },
    "./cli": {
      "import": "./src/cli/cli.js",
      "default": "./src/cli/cli.js"
    },
    "./subtitles": {
      "types": "./src/subtitles/resolver/subtitleResolver.d.ts",
      "import": "./src/subtitles/resolver/subtitleResolver.js",
      "default": "./src/subtitles/resolver/subtitleResolver.js"
    },
    "./audio": {
      "types": "./src/subtitles/resolver/audioResolver.d.ts",
      "import": "./src/subtitles/resolver/audioResolver.js",
      "default": "./src/subtitles/resolver/audioResolver.js"
    },
    "./quality": {
      "types": "./src/subtitles/resolver/qualityResolver.d.ts",
      "import": "./src/subtitles/resolver/qualityResolver.js",
      "default": "./src/subtitles/resolver/qualityResolver.js"
    },
    "./tts": {
      "types": "./src/subtitles/tts/index.d.ts",
      "import": "./src/subtitles/tts/index.js",
      "default": "./src/subtitles/tts/index.js"
    },
    "./policy": {
      "types": "./src/subtitles/policy/PolicyEngine.d.ts",
      "import": "./src/subtitles/policy/index.js",
      "default": "./src/subtitles/policy/index.js"
    },
    "./network": {
      "types": "./src/subtitles/network/index.d.ts",
      "import": "./src/subtitles/network/index.js",
      "default": "./src/subtitles/network/index.js"
    },
    "./cache": {
      "types": "./src/subtitles/cache/ModelCacheManager.d.ts",
      "import": "./src/subtitles/cache/index.js",
      "default": "./src/subtitles/cache/index.js"
    },
    "./errors": {
      "types": "./src/subtitles/errors/index.d.ts",
      "import": "./src/subtitles/errors/index.js",
      "default": "./src/subtitles/errors/index.js"
    },
    "./models": {
      "types": "./src/subtitles/models/modelRegistry.d.ts",
      "import": "./src/subtitles/models/modelRegistry.js",
      "default": "./src/subtitles/models/modelRegistry.js"
    },
    "./languages": {
      "types": "./src/subtitles/languages/capabilityResolver.d.ts",
      "import": "./src/subtitles/languages/capabilityResolver.js",
      "default": "./src/subtitles/languages/capabilityResolver.js"
    },
    "./dist/style.css": "./dist/tavi-video-tutor.css",
    "./dist/tavi-video-tutor.css": "./dist/tavi-video-tutor.css",
    "./style.css": "./dist/tavi-video-tutor.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "test:qa": "node scripts/runEdgeCaseAndProductionQA.js"
  },
  "keywords": [
    "aitutor",
    "tavi-video-tutor",
    "subtitles",
    "webvtt",
    "whisper",
    "nllb",
    "multilingual",
    "react-video-player",
    "asr",
    "translation",
    "video-quality",
    "h264-transcoding"
  ],
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@huggingface/transformers": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.1"
  }
}
