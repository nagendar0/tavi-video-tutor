{
  "name": "tavi-video-tutor",
  "version": "0.4.0",
  "description": "Custom, zero-dependency Socratic AI video tutor player with native canvas rendering, audio dub sync, and multilingual subtitles.",
  "type": "module",
  "main": "./dist/tavi-video-tutor.umd.cjs",
  "module": "./dist/tavi-video-tutor.js",
  "exports": {
    ".": {
      "import": "./dist/tavi-video-tutor.js",
      "require": "./dist/tavi-video-tutor.umd.cjs"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "README.md"
  ],
  "bin": {
    "aitutor": "./bin/aitutor.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "aitutor": "node ./bin/aitutor.js",
    "qa:subtitle": "node scripts/runCompleteSystemAudit.js"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "puppeteer": "^25.4.0",
    "vite": "^5.3.1"
  },
  "keywords": [
    "education",
    "video",
    "player",
    "tutor",
    "socratic",
    "react",
    "multilingual"
  ],
  "license": "MIT",
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "optionalDependencies": {
    "@img/sharp-win32-arm64": "^0.35.3",
    "@img/sharp-win32-x64": "^0.35.3"
  }
}
